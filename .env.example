APP_NAME="LuckyDive Generator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=ko
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ko_KR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=debug

# 생성기 전용 DB 정보를 직접 입력합니다. 초기화 과정은 DB에 접속하지 않습니다.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TIMEZONE=+09:00

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# 운영 주소와 프로필별 토큰은 API 연결 구현 시 설정합니다.
LUCKYDIVE_API_BASE_URL=
LUCKYDIVE_CA_BUNDLE=
LUCKYDIVE_AI_RANDOM_TOKEN=
LUCKYDIVE_AI_RANDOM_PROFILE_ID=
LUCKYDIVE_AI_FILTERED_TOKEN=
LUCKYDIVE_AI_FILTERED_PROFILE_ID=
LUCKYDIVE_AI_WEIGHTED_TOKEN=
LUCKYDIVE_AI_WEIGHTED_PROFILE_ID=
